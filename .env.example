# Copy to `.env` and adjust for your setup. Do not commit `.env`.

# Absolute or relative path to the trained EfficientNet-B0 checkpoint (.pth).
# Default: ./model/skin_disease_classification_model.pth
MODEL_PATH=

# Absolute or relative path to the SQLite log of predictions.
# Default: ./predictions.db (next to app.py)
HISTORY_DB_PATH=

# Optional Flask dev-server settings (used only when running `python app.py`).
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
